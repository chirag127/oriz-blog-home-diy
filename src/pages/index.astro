---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — "The Workbench" front board (PEGBOARD archetype).
 *
 * Thesis: this is a pegboard over a workbench, not a magazine front page.
 *   1. HERO — a pinned blueprint project sheet (the thesis, kept from theme).
 *   2. ON THE BENCH — in-progress series, each a job card on the rail (spine).
 *   3. THE BOARD — recent posts as cards HUNG on pegboard hooks, each with a
 *      punched peg-hole and tool-tag chips (room + reading time).
 *   4. HOOKS — rooms/tasks as physical hang-tags on a peg rail.
 *
 * No centered top-nav card grid. Cards are pinned tiles on a perforated board.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const boardPosts = allPosts.slice(1, 10)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const now = new Date()
const dateline = now.toLocaleDateString('en-GB', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
})
const volume = now.getFullYear() - 2018
const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d ago'
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1mo ago'
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1y ago' : `${years}y ago`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="The Workbench — Home & DIY projects, tools, and honest costs"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
  hideSidebar
>
  <div class="board-wrap">
    {/* ── HERO: pinned blueprint project sheet ────────────────────────── */}
    <section class="masthead" aria-label="Workbench">
      <div class="dateline mono">
        <span class="dateline-vol">Sheet {volume}</span>
        <span class="dateline-sep" aria-hidden="true">·</span>
        <span class="dateline-date">{dateline}</span>
        <span class="dateline-sep" aria-hidden="true">·</span>
        <span class="dateline-count"><span class="count">{allPosts.length}</span> projects logged</span>
      </div>
      <div class="blueprint">
        <span class="bp-pin" aria-hidden="true"></span>
        <span class="bp-pin bp-pin--r" aria-hidden="true"></span>
        <p class="nameplate">Fix it. Sort it. Make it feel like home.</p>
        <p class="nameplate-sub">Small home projects worth doing yourself — real steps, real tool lists, no jargon. Start on a Saturday, finish before dinner.</p>
        <ul class="spec-strip mono" aria-label="What you get">
          <li><span class="spec-k">Skill</span><span class="spec-v">beginner-friendly</span></li>
          <li><span class="spec-k">Cost</span><span class="spec-v">low, listed up front</span></li>
          <li><span class="spec-k">Tools</span><span class="spec-v">the basic kit</span></li>
        </ul>
      </div>
    </section>

    {/* ── ON THE BENCH: in-progress series (job cards) ────────────────── */}
    {inProgress.length > 0 && (
      <section class="rail" aria-labelledby="s-bench">
        <h2 id="s-bench" class="rail-h mono"><span class="rail-tick" aria-hidden="true"></span>On the bench</h2>
        <ul class="job-list">
          {inProgress.map((s) => (
            <li class="job-row">
              <a class="job-link" href={`/series/${s.slug}/`}>
                <span class="job-name">{s.name}</span>
                <span class="job-meta mono">step {s.published} of {s.total}</span>
                <span class="job-spine">
                  <SeriesSpine total={s.total} published={s.published} current={s.current} size="md" />
                </span>
                <span class="job-ago mono">{ago(s.latest)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* ── THE BOARD: lead + recent posts pinned as cards ──────────────── */}
    <section class="board" aria-labelledby="s-board">
      <h2 id="s-board" class="rail-h mono"><span class="rail-tick" aria-hidden="true"></span>The board</h2>
      <ul class="pegboard">
        {lead && (
          <li class="peg-card peg-card--lead" data-vertical={leadVertical}>
            <span class="peg-hole" aria-hidden="true"></span>
            <a class="peg-link" href={`/blog/${lead.id}`}>
              <span class="peg-tags mono">
                <span class="peg-tag peg-tag--desk">{verticalLabel(leadVertical)}</span>
                <span class="peg-tag peg-tag--flag">Start here</span>
              </span>
              <h3 class="peg-title peg-title--lead">{lead.data.title}</h3>
              <p class="peg-dek">{lead.data.description}</p>
              <span class="peg-foot mono">
                <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toISOString().slice(0, 10)}</time>
                <span aria-hidden="true">·</span><span>{leadRt}</span>
              </span>
            </a>
          </li>
        )}
        {boardPosts.map((p) => {
          const vert = postVertical(p)
          const rt = p.data.readingTime ?? readingTimeFor(p)
          return (
            <li class="peg-card" data-vertical={vert}>
              <span class="peg-hole" aria-hidden="true"></span>
              <a class="peg-link" href={`/blog/${p.id}`}>
                <span class="peg-tags mono">
                  <span class="peg-tag peg-tag--desk">{verticalLabel(vert)}</span>
                  <span class="peg-tag">{p.data.category}</span>
                </span>
                <h3 class="peg-title">{p.data.title}</h3>
                <p class="peg-dek">{p.data.description}</p>
                <span class="peg-foot mono">
                  <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
                  <span aria-hidden="true">·</span><span>{rt}</span>
                </span>
              </a>
            </li>
          )
        })}
      </ul>
      <p class="all-link"><a href="/archive/">every project in the archive →</a></p>
    </section>

    {/* ── HOOKS: rooms & tasks as hang-tags ───────────────────────────── */}
    {cats.length > 0 && (
      <section class="rail" aria-labelledby="s-hooks">
        <h2 id="s-hooks" class="rail-h mono"><span class="rail-tick" aria-hidden="true"></span>Hooks — rooms &amp; tasks</h2>
        <ul class="hook-rail">
          {cats.map((c) => (
            <li>
              <a class="hook-tag" href={`/categories/${slugifyTag(c.category)}/`} data-vertical={verticalFor(c.category)}>
                <span class="hook-hole" aria-hidden="true"></span>
                <span class="hook-name">{c.category}</span>
                <span class="hook-count mono">{c.count}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .board-wrap {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
    padding-bottom: 3rem;
  }

  /* ── Masthead / blueprint hero ─────────────────────────────────────── */
  .masthead { padding-block: clamp(1.75rem, 5vw, 3rem) 1.5rem; }
  .dateline {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--ink-mute); padding-bottom: 0.875rem;
    border-bottom: 2px dashed var(--rule-strong); margin-bottom: 1.5rem;
  }
  .dateline-vol { color: var(--blueprint); font-weight: 700; }
  .dateline-sep { color: var(--rule-strong, var(--rule)); }
  .dateline .count { color: var(--tape-ink); }

  .blueprint {
    position: relative;
    border: 2px solid var(--blueprint);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background:
      linear-gradient(color-mix(in oklab, var(--paper) 84%, transparent), color-mix(in oklab, var(--paper) 84%, transparent)),
      repeating-linear-gradient(0deg, var(--grid) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(90deg, var(--grid) 0 1px, transparent 1px 26px);
  }
  .bp-pin {
    position: absolute; top: -8px; left: 22px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--tape); border: 2px solid var(--tape-ink);
    box-shadow: 0 2px 3px color-mix(in oklab, var(--ink) 25%, transparent);
  }
  .bp-pin--r { left: auto; right: 22px; }
  .nameplate {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 6.5vw, 3.75rem);
    font-weight: 600; font-variation-settings: "opsz" 144, "SOFT" 40;
    letter-spacing: -0.02em; line-height: 1.02; color: var(--ink);
    margin: 0; max-width: 15ch;
  }
  .nameplate-sub {
    font-family: var(--font-body); font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5; color: var(--ink-mute); margin: 1rem 0 0; max-width: 52ch;
  }
  .spec-strip {
    list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem;
    margin: 1.5rem 0 0; padding: 0.875rem 0 0;
    border-top: 1px solid var(--rule); font-size: 12px;
  }
  .spec-strip li { display: inline-flex; align-items: baseline; gap: 0.5rem; }
  .spec-k { color: var(--tape-ink); text-transform: uppercase; letter-spacing: 0.14em; font-weight: 700; }
  .spec-v { color: var(--ink); }

  /* ── Section rails (shared heading) ────────────────────────────────── */
  .rail { padding-block: 1.75rem 0.5rem; }
  .rail-h {
    display: flex; align-items: center; gap: 0.5rem;
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.18em; color: var(--ink-mute); font-weight: 500; margin: 0 0 1.25rem;
  }
  .rail-tick { width: 9px; height: 9px; background: var(--tape); border: 1.5px solid var(--tape-ink); border-radius: 50%; flex: 0 0 auto; }

  /* ── On the bench (job cards) ──────────────────────────────────────── */
  .job-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .job-link {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 1rem;
    align-items: baseline; color: var(--ink); text-decoration: none;
    padding: 0.6rem 0.85rem; border: 1px dashed var(--rule-strong); border-radius: var(--radius-card);
    background: var(--paper); transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .job-link:hover { border-color: var(--blueprint); border-style: solid; color: var(--blueprint); }
  .job-link:hover .job-meta, .job-link:hover .job-ago { color: var(--blueprint); }
  .job-name {
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; letter-spacing: -0.01em;
    color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .job-meta, .job-ago { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; color: var(--ink-mute); }
  .job-spine { display: inline-flex; }
  @media (max-width: 640px) {
    .job-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name ago' 'meta meta' 'spine spine'; row-gap: 0.3rem;
    }
    .job-name { grid-area: name; } .job-meta { grid-area: meta; }
    .job-spine { grid-area: spine; } .job-ago { grid-area: ago; text-align: right; }
  }

  /* ── The board (pegboard grid) ─────────────────────────────────────── */
  .board {
    padding-block: 1.75rem 0.5rem;
    /* perforated board backing behind the whole grid */
    --peg: color-mix(in oklab, var(--rule-strong) 45%, transparent);
  }
  .pegboard {
    list-style: none; margin: 0; padding: 1.25rem;
    display: grid; grid-template-columns: 1fr; gap: 1.25rem;
    background:
      radial-gradient(circle at center, var(--peg) 1.3px, transparent 1.8px) 0 0 / 26px 26px;
    border: 1px solid var(--rule); border-radius: var(--radius-card);
  }
  @media (min-width: 620px) { .pegboard { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .pegboard { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; padding: 1.5rem; } }

  .peg-card {
    position: relative;
    --v: var(--v-personal);
    background: var(--paper);
    border: 1.5px solid var(--rule-strong);
    border-top: 3px solid var(--v);
    border-radius: var(--radius-card);
    box-shadow: 2px 3px 0 color-mix(in oklab, var(--ink) 8%, transparent);
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) ease;
  }
  .peg-card[data-vertical='dev'] { --v: var(--v-dev); }
  .peg-card[data-vertical='finance'] { --v: var(--v-finance); }
  .peg-card[data-vertical='culture'] { --v: var(--v-culture); }
  .peg-card[data-vertical='health'] { --v: var(--v-health); }
  /* the peg hole + hook the card hangs from */
  .peg-hole {
    position: absolute; top: -9px; left: 50%; transform: translateX(-50%);
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--paper-2); border: 2px solid var(--rule-strong); z-index: 1;
  }
  .peg-hole::after {
    content: ''; position: absolute; left: 50%; top: -6px; transform: translateX(-50%);
    width: 3px; height: 8px; background: var(--tape-ink); border-radius: 2px;
  }
  .peg-card:hover { transform: translateY(-3px) rotate(-0.5deg); box-shadow: 3px 6px 0 color-mix(in oklab, var(--ink) 12%, transparent); }

  .peg-card--lead {
    border-top-color: var(--tape);
    box-shadow: 3px 4px 0 color-mix(in oklab, var(--tape) 30%, transparent);
  }
  @media (min-width: 620px) { .peg-card--lead { grid-column: 1 / -1; } }

  .peg-link { display: grid; gap: 0.55rem; padding: 1.1rem 1.1rem 1.2rem; color: var(--ink); text-decoration: none; }
  .peg-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .peg-tag {
    font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-mute); background: var(--paper-2);
    border: 1px solid var(--rule); border-radius: 2px 7px 7px 2px;
    padding: 0.15rem 0.5rem 0.15rem 0.45rem;
  }
  .peg-tag--desk { color: var(--v); border-color: color-mix(in oklab, var(--v) 45%, var(--rule)); font-weight: 600; }
  .peg-tag--flag { color: #241c00; background: var(--tape); border-color: var(--tape-ink); font-weight: 700; }
  .peg-title {
    font-family: var(--font-display); font-size: 1.2rem; font-weight: 600;
    letter-spacing: -0.015em; line-height: 1.22; margin: 0; color: var(--ink);
  }
  .peg-title--lead { font-size: clamp(1.6rem, 3.4vw, 2.35rem); line-height: 1.1; max-width: 20ch; }
  .peg-link:hover .peg-title { color: var(--accent); }
  .peg-dek {
    font-family: var(--font-body); font-size: 0.9rem; line-height: 1.5; color: var(--ink-mute); margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .peg-card--lead .peg-dek { font-size: 1.05rem; -webkit-line-clamp: 2; line-clamp: 2; max-width: 58ch; }
  .peg-foot { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }

  .all-link { margin: 1.5rem 0 0; font-family: var(--font-sans); font-size: 13.6px; }
  .all-link a {
    color: var(--ink-mute); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--rule);
  }
  .all-link a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ── Hooks (hang-tags) ─────────────────────────────────────────────── */
  .hook-rail { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .hook-tag {
    --v: var(--v-personal);
    position: relative; display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.4rem 0.7rem 0.4rem 0.85rem; text-decoration: none; color: var(--ink);
    background: var(--paper); border: 1.5px solid var(--rule-strong);
    border-radius: 2px 10px 10px 2px;
    transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .hook-tag[data-vertical='dev'] { --v: var(--v-dev); }
  .hook-tag[data-vertical='finance'] { --v: var(--v-finance); }
  .hook-tag[data-vertical='culture'] { --v: var(--v-culture); }
  .hook-tag[data-vertical='health'] { --v: var(--v-health); }
  .hook-hole { width: 8px; height: 8px; border-radius: 50%; background: var(--paper-2); border: 1.5px solid var(--rule-strong); flex: 0 0 auto; }
  .hook-name { font-family: var(--font-display); font-size: 15px; font-weight: 600; letter-spacing: -0.01em; }
  .hook-count { font-size: 10px; color: var(--ink-mute); }
  .hook-tag:hover { transform: rotate(-2deg) translateY(1px); border-color: var(--v); color: var(--v); }
  .hook-tag:hover .hook-hole { border-color: var(--v); }

  @media (prefers-reduced-motion: reduce) {
    .peg-card, .hook-tag { transition: none; }
    .peg-card:hover, .hook-tag:hover { transform: none; }
  }
</style>

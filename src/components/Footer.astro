---
/*
 * blog-app Footer — "Signal Press" editorial surface.
 *
 * Signature element: a serif pull-quote (Source Serif 4) with a signal-orange
 * quote mark — the only place the footer raises its voice. Everything else
 * stays library-quiet: mono column headings, mono tag links, hairline rules.
 *
 * Reads palette + type from the editorial tokens (tokens.css / global.css).
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const categories = [
  { name: 'All categories', slug: '' },
  ...(await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
    name: category,
    slug: slugifyTag(category),
  })),
]
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="blog-footer" role="contentinfo">
  <span class="bf-perf" aria-hidden="true"></span>
  <div class="bf-quote">
    <blockquote>
      <span aria-hidden="true" class="bf-q-mark">“</span>
      Measure twice. Write it down once.
    </blockquote>
    <p class="bf-quote-attr">— home&diy · the workbench</p>
  </div>
  <div class="bf-grid">
    <div class="bf-col">
      <h3 class="bf-h"><span class="bf-hook" aria-hidden="true"></span>Rooms</h3>
      <ul class="bf-tags">
        {categories.map((c) => <li><a href={c.slug ? `/categories/${c.slug}/` : '/categories/'}>{c.name}</a></li>)}
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h"><span class="bf-hook" aria-hidden="true"></span>The bench</h3>
      <ul class="bf-tags">
        <li><a href="/blog/">Latest</a></li>
        <li><a href="/archive/">Archive</a></li>
        <li><a href="/series/">Guides</a></li>
        <li><a href="/now/">Now</a></li>
      </ul>
    </div>
    <div class="bf-col">
      <h3 class="bf-h"><span class="bf-hook" aria-hidden="true"></span>Tools &amp; tags</h3>
      <ul class="bf-tags">
        {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
      </ul>
    </div>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-home-diy"
    appName="The Workbench"
    bio="Small home projects worth doing yourself — real steps, tool lists, and honest costs. By Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .blog-footer {
    position: relative;
    margin-top: 5rem;
    background:
      radial-gradient(circle at center, color-mix(in oklab, var(--rule-strong) 40%, transparent) 1.2px, transparent 1.7px) 0 0 / 24px 24px,
      var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 2px solid var(--blueprint);
  }
  /* torn perforation strip along the top edge */
  .bf-perf {
    position: absolute; left: 0; right: 0; top: -1px; height: 5px;
    background: radial-gradient(circle at center, var(--tape) 1px, transparent 1.4px) 0 center / 14px 5px repeat-x;
    opacity: 0.6;
  }
  .bf-quote {
    max-width: var(--container-page, 1100px); margin: 0 auto;
    padding: 48px 16px 24px;
    text-align: left;
  }
  .bf-quote blockquote {
    margin: 0;
    font-family: var(--font-display, 'Fraunces', Georgia, serif);
    font-style: normal; font-weight: 600; font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.3; letter-spacing: -0.015em;
    color: var(--color-ink, var(--ink)); max-width: 560px;
  }
  .bf-q-mark { font-size: 1.5em; line-height: 0; color: var(--tape, #f2b705); margin-right: 4px; }
  .bf-quote-attr {
    margin: 16px 0 0; font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.2em;
    color: var(--color-ink-mute, var(--ink-mute));
  }
  .bf-grid {
    max-width: var(--container-page, 1100px); margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 24px;
    padding: 12px 16px 24px;
  }
  .bf-h {
    display: flex; align-items: center; gap: 8px;
    margin: 0 0 14px;
    font-family: var(--font-mono, ui-monospace);
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--color-ink-mute, var(--ink-mute)); font-weight: 500;
  }
  .bf-hook { width: 8px; height: 8px; border-radius: 50%; background: var(--tape); border: 1.5px solid var(--tape-ink); flex: 0 0 auto; }
  /* every footer link is a small hang-tag */
  .bf-tags { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .bf-tags a {
    display: inline-flex; align-items: center;
    font-family: var(--font-mono, ui-monospace); font-size: 12px;
    color: var(--color-ink, var(--ink)); text-decoration: none;
    padding: 3px 9px 3px 11px;
    background: var(--paper); border: 1.5px solid var(--rule-strong, var(--rule));
    border-radius: 2px 8px 8px 2px;
    transition: border-color 120ms ease, color 120ms ease;
  }
  .bf-tags a:hover { color: var(--blueprint); border-color: var(--blueprint); text-decoration: none; }
  @media (min-width: 768px) { .bf-grid { grid-template-columns: 1fr 1fr 1fr; gap: 32px; padding: 16px 24px 28px; } .bf-quote { padding: 64px 24px 20px; } }
  @media (min-width: 1024px) { .bf-grid { grid-template-columns: repeat(3, 1fr); padding: 16px 24px 32px; } }
</style>

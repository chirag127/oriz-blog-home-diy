---
/**
 * PostCard — pegboard tile ("The Workbench"). A card HUNG on the board:
 * a punched peg-hole at top, a coloured desk edge, tool-tag chips (desk +
 * category), a serif headline, a clamped dek, and a mono date · reading-time
 * foot. Used by every listing (blog index, tag, category, related) so the
 * whole site reads as one pegboard — not a hairline dispatch ledger.
 */
import type { CollectionEntry } from 'astro:content'
import { formatPostDate, postVertical, slugifyTag, verticalLabel } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const vert = postVertical(post)
---

<article class="peg-tile" data-vertical={vert}>
  <span class="peg-hole" aria-hidden="true"></span>
  <a class="peg-tile-link" href={href}>
    <span class="peg-tile-tags mono">
      <span class="peg-tile-tag peg-tile-tag--desk">{verticalLabel(vert)}</span>
      <span class="peg-tile-tag">{category}</span>
    </span>
    <h3 class="peg-tile-title">{title}</h3>
    <p class="peg-tile-dek">{description}</p>
    <span class="peg-tile-foot">
      <time datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
      {readingTime && <span class="peg-tile-rt">· {readingTime}</span>}
    </span>
  </a>
</article>

<style>
  .peg-tile {
    position: relative;
    --v: var(--v-personal);
    background: var(--paper);
    border: 1.5px solid var(--rule-strong);
    border-top: 3px solid var(--v);
    border-radius: var(--radius-card);
    box-shadow: 2px 3px 0 color-mix(in oklab, var(--ink) 8%, transparent);
    transition: transform var(--dur-fast, 120ms) var(--ease-out, ease), box-shadow var(--dur-fast, 120ms) ease;
  }
  .peg-tile[data-vertical='dev'] { --v: var(--v-dev); }
  .peg-tile[data-vertical='finance'] { --v: var(--v-finance); }
  .peg-tile[data-vertical='culture'] { --v: var(--v-culture); }
  .peg-tile[data-vertical='health'] { --v: var(--v-health); }
  .peg-tile:hover { transform: translateY(-3px) rotate(-0.5deg); box-shadow: 3px 6px 0 color-mix(in oklab, var(--ink) 12%, transparent); }

  .peg-hole {
    position: absolute; top: -9px; left: 50%; transform: translateX(-50%);
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--paper-2); border: 2px solid var(--rule-strong); z-index: 1;
  }
  .peg-hole::after {
    content: ''; position: absolute; left: 50%; top: -6px; transform: translateX(-50%);
    width: 3px; height: 8px; background: var(--tape-ink); border-radius: 2px;
  }

  .peg-tile-link { display: grid; gap: 0.5rem; padding: 1.05rem 1.05rem 1.15rem; text-decoration: none; color: var(--ink); }

  .peg-tile-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .peg-tile-tag {
    font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink-mute); background: var(--paper-2);
    border: 1px solid var(--rule); border-radius: 2px 7px 7px 2px;
    padding: 0.15rem 0.5rem 0.15rem 0.45rem;
  }
  .peg-tile-tag--desk { color: var(--v); border-color: color-mix(in oklab, var(--v) 45%, var(--rule)); font-weight: 600; }

  .peg-tile-title {
    font-family: var(--font-display); font-size: 1.2rem; font-weight: 600;
    letter-spacing: -0.015em; line-height: 1.22; margin: 0; color: var(--ink);
  }
  .peg-tile-link:hover .peg-tile-title { color: var(--accent); }

  .peg-tile-dek {
    color: var(--ink-mute); font-family: var(--font-body); font-size: 0.9rem; line-height: 1.5; margin: 0;
    overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical;
  }
  .peg-tile-foot {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; color: var(--ink-mute);
  }

  @media (prefers-reduced-motion: reduce) {
    .peg-tile { transition: none; }
    .peg-tile:hover { transform: none; }
  }
</style>
